PORT=8080
FRONTEND_URL=https://sekolah.com

# Frontend variables (Vite requires VITE_ prefix)
# Sesuaikan VITE_API_URL dan VITE_API_BASE dengan domain production Anda
VITE_API_URL=https://sekolah.com/api
VITE_API_BASE=https://sekolah.com/api
VITE_ASSET_BASE=https://sekolah.com
VITE_PORT=80

# Database configuration (Sesuaikan dengan kredensial Postgres di Docker Compose)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=go_school_blog
DB_SSLMODE=disable

# JWT Secret (Ganti dengan string acak yang panjang dan aman!)
JWT_SECRET=your_super_secret_production_key_here
